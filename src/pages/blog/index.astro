---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION, SITE_KEYWORDS, CATEGORY_LABELS } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="zh-Hant">
	<head>
		<BaseHead title={`研究報告 · ${SITE_TITLE}`} description={SITE_DESCRIPTION} keywords={SITE_KEYWORDS} />
		<style>
			main {
				width: 720px;
			}
			ol {
				list-style: none;
				margin: 0;
				padding: 0;
				counter-reset: report;
			}
			ol li {
				counter-increment: report;
				padding: var(--space-md) 0;
				border-bottom: 1px solid var(--color-rule);
			}
			ol li:first-child {
				padding-top: 0;
			}
			ol li a {
				display: grid;
				grid-template-columns: 3ch 1fr;
				gap: var(--space-sm);
				text-decoration: none;
				color: var(--color-ink);
			}
			ol li a::before {
				content: counter(report, decimal-leading-zero);
				font-family: var(--font-mono);
				font-size: var(--text-sm);
				color: var(--color-neutral);
				padding-top: 0.2em;
			}
			.title {
				margin: 0;
				font-family: var(--font-display);
				font-size: var(--text-lg);
				line-height: 1.35;
			}
			.category {
				display: inline-block;
				margin: 0 0 var(--space-3xs);
				font-family: var(--font-mono);
				font-size: var(--text-xs);
				letter-spacing: 0.04em;
				color: var(--color-accent-ink);
				background: var(--color-cat-stock);
				border-radius: var(--radius-pill);
				padding: var(--space-3xs) var(--space-xs);
			}
			.category[data-category='industry'] {
				background: var(--color-cat-industry);
			}
			.category[data-category='theme'] {
				background: var(--color-cat-theme);
			}
			.desc {
				margin: var(--space-3xs) 0 0;
				font-size: var(--text-sm);
				color: var(--color-muted);
			}
			.date {
				display: block;
				margin-top: var(--space-2xs);
				font-family: var(--font-mono);
				font-size: var(--text-xs);
				color: var(--color-neutral);
			}
			ol li a:hover .title {
				color: var(--color-accent);
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>研究報告</h1>
			<section>
				<ol>
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									<span>
										<span class="category" data-category={post.data.category}>
											{CATEGORY_LABELS[post.data.category] ?? post.data.category}
										</span>
										<p class="title">{post.data.title}</p>
										<p class="desc">{post.data.description}</p>
										<span class="date">
											<FormattedDate date={post.data.pubDate} />
										</span>
									</span>
								</a>
							</li>
						))
					}
				</ol>
			</section>
		</main>
		<Footer />
	</body>
</html>
