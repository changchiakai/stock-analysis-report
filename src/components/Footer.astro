---
import { SITE_TITLE } from '../consts';
const today = new Date();
---

<footer>
	<div class="mast">
		<p class="wordmark">{SITE_TITLE}</p>
		<p class="tagline">由 AI 蒐集、交叉驗證與撰寫,人工覆核發布</p>
	</div>
	<nav>
		<a href="/">首頁</a>
		<a href="/blog">研究報告</a>
		<a href="/about">關於</a>
	</nav>
	<p class="disclaimer">
		本站報告為 AI 輔助分析之研究筆記,數據可能有誤或滯後,僅供個人研究參考,不構成任何投資建議或要約。
	</p>
	<p class="contact">聯絡信箱:<a href="mailto:cckkaai@cckkaai.com">cckkaai@cckkaai.com</a></p>
	<p class="copyright">&copy; {today.getFullYear()} {SITE_TITLE}</p>
</footer>
<style>
	footer {
		max-width: 960px;
		margin: 0 auto;
		padding: var(--space-xl) var(--space-sm) var(--space-2xl);
		border-top: 1px solid var(--color-rule);
		text-align: center;
	}
	.mast {
		margin-bottom: var(--space-md);
	}
	.wordmark {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: var(--text-lg);
		color: var(--color-ink);
		margin: 0 0 var(--space-3xs) 0;
	}
	.tagline {
		font-size: var(--text-sm);
		color: var(--color-muted);
		margin: 0;
	}
	nav {
		display: flex;
		justify-content: center;
		gap: var(--space-md);
		font-family: var(--font-mono);
		font-size: var(--text-sm);
		margin-bottom: var(--space-md);
	}
	nav a {
		color: var(--color-muted);
		text-decoration: none;
	}
	nav a:hover {
		color: var(--color-ink);
	}
	.disclaimer {
		max-width: 52ch;
		margin: 0 auto var(--space-sm);
		font-size: var(--text-xs);
		line-height: 1.6;
		color: var(--color-muted);
	}
	.contact {
		font-size: var(--text-xs);
		color: var(--color-muted);
		margin: 0 0 var(--space-sm);
	}
	.contact a {
		color: var(--color-muted);
	}
	.copyright {
		font-size: var(--text-xs);
		color: var(--color-neutral);
		margin: 0;
	}
</style>

