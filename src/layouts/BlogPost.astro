---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'] & { headings?: MarkdownHeading[] };

const { title, description, pubDate, updatedDate, heroImage, keywords, headings = [] } = Astro.props;
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

<html lang="zh-Hant">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={heroImage}
			keywords={keywords}
			type="article"
			publishedTime={pubDate}
			modifiedTime={updatedDate}
		/>
		<style>
			main {
				width: var(--measure);
			}
			.layout {
				display: flex;
				align-items: flex-start;
				gap: var(--space-xl);
			}
			.layout article {
				flex: 1;
				min-width: 0;
			}
			.toc {
				display: none;
			}
			@media (min-width: 1280px) {
				main {
					width: min(calc(100% - 2em), calc(var(--measure) + 17rem));
				}
				.toc {
					display: block;
					position: sticky;
					top: var(--space-lg);
					width: 15rem;
					flex-shrink: 0;
					max-height: calc(100vh - var(--space-2xl));
					overflow-y: auto;
					padding-left: var(--space-md);
					border-left: 1px solid var(--color-rule);
				}
			}
			.toc-title {
				margin: 0 0 var(--space-sm);
				font-family: var(--font-mono);
				font-size: var(--text-xs);
				letter-spacing: 0.06em;
				text-transform: uppercase;
				color: var(--color-neutral);
			}
			.toc ol {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.toc li {
				margin: 0;
			}
			.toc li[data-depth='3'] {
				padding-left: var(--space-sm);
			}
			.toc a {
				display: block;
				padding: var(--space-3xs) 0;
				font-size: var(--text-sm);
				line-height: 1.4;
				color: var(--color-muted);
				text-decoration: none;
				border-left: 2px solid transparent;
				margin-left: calc(-1 * var(--space-md) - 1px);
				padding-left: var(--space-md);
			}
			.toc a:hover {
				color: var(--color-ink);
			}
			.toc a[aria-current='true'] {
				color: var(--color-accent);
				border-left-color: var(--color-accent);
			}
			.back-link {
				display: inline-block;
				font-family: var(--font-mono);
				font-size: var(--text-sm);
				color: var(--color-muted);
				text-decoration: none;
				margin-bottom: var(--space-lg);
			}
			.back-link:hover {
				color: var(--color-accent);
			}
			.hero-image img {
				display: block;
				margin: 0 auto var(--space-lg);
				max-width: var(--measure);
				border: 1px solid var(--color-rule);
			}
			.title {
				margin-bottom: var(--space-lg);
			}
			.meta {
				display: flex;
				flex-wrap: wrap;
				gap: var(--space-2xs) var(--space-sm);
				align-items: baseline;
				font-family: var(--font-mono);
				font-size: var(--text-sm);
				color: var(--color-muted);
				margin-bottom: var(--space-sm);
			}
			.updated {
				font-style: normal;
			}
			.title h1 {
				margin: 0;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<div class="layout">
				<article>
					<a class="back-link" href="/blog">&larr; 回研究報告列表</a>
					{
						heroImage && (
							<div class="hero-image">
								<img width={1020} height={510} src={heroImage} alt="" loading="eager" />
							</div>
					)
				}
					<div class="prose">
						<div class="title">
							<div class="meta">
								<FormattedDate date={pubDate} />
								{
									updatedDate && (
										<span class="updated">· 最後更新 <FormattedDate date={updatedDate} /></span>
									)
								}
							</div>
							<h1>{title}</h1>
						</div>
						<hr />
						<slot />
					</div>
				</article>
				{
					toc.length > 0 && (
						<aside class="toc" aria-label="文章大綱">
							<p class="toc-title">大綱</p>
							<nav>
								<ol>
									{toc.map((h) => (
										<li data-depth={h.depth}>
											<a href={`#${h.slug}`}>{h.text}</a>
										</li>
									))}
								</ol>
							</nav>
						</aside>
					)
				}
			</div>
		</main>
		<Footer />
		{
			toc.length > 0 && (
				<script>
					const links = document.querySelectorAll<HTMLAnchorElement>('.toc a');
					if (links.length) {
						const headingEls = Array.from(links)
							.map((link) => document.getElementById(link.hash.slice(1)))
							.filter((el): el is HTMLElement => el !== null);
						const setActive = (id: string) => {
							links.forEach((link) => {
								link.toggleAttribute('aria-current', link.hash === `#${id}`);
							});
						};
						const observer = new IntersectionObserver(
							(entries) => {
								const visible = entries.filter((e) => e.isIntersecting);
								if (visible.length > 0) {
									setActive(visible[0].target.id);
								}
							},
							{ rootMargin: '-10% 0px -70% 0px' },
						);
						headingEls.forEach((el) => observer.observe(el));
					}
				</script>
			)
		}
	</body>
</html>
