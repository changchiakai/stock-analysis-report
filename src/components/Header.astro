---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<p class="kicker">研究站 · 深度研究 · AI 撰寫</p>
	<p class="wordmark"><a href="/">{SITE_TITLE}</a></p>
	<nav>
		<HeaderLink href="/">首頁</HeaderLink>
		<HeaderLink href="/blog">研究報告</HeaderLink>
		<HeaderLink href="/keywords">關聯圖</HeaderLink>
		<HeaderLink href="/about">關於</HeaderLink>
	</nav>
</header>
<style>
	header {
		margin: 0 auto;
		max-width: 960px;
		padding: var(--space-lg) var(--space-sm) 0;
		text-align: center;
	}
	.kicker {
		margin: 0 0 var(--space-2xs) 0;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: 0.12em;
		color: var(--color-muted);
	}
	.wordmark {
		margin: 0 0 var(--space-sm) 0;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: var(--text-2xl);
	}
	.wordmark a {
		color: var(--color-ink);
		text-decoration: none;
	}
	nav {
		display: flex;
		justify-content: center;
		gap: var(--space-md);
		padding-bottom: var(--space-md);
		border-bottom: 1px solid var(--color-rule);
		position: relative;
	}
	nav::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -5px;
		border-bottom: 1px solid var(--color-rule);
	}
	nav :global(a) {
		font-family: var(--font-mono);
		font-size: var(--text-sm);
		color: var(--color-muted);
		text-decoration: none;
		padding: var(--space-3xs) 0;
		border-bottom: 2px solid transparent;
	}
	nav :global(a:hover) {
		color: var(--color-ink);
	}
	nav :global(a.active) {
		color: var(--color-ink);
		font-weight: 600;
		border-bottom-color: var(--color-accent);
	}
</style>

