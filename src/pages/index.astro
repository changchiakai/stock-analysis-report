---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION, SITE_KEYWORDS } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latest = posts.slice(0, 5);
---

<!doctype html>
<html lang="zh-Hant">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} keywords={SITE_KEYWORDS} />
		<style>
			.intro p {
				max-width: var(--measure);
			}
			.method {
				list-style: none;
				margin: var(--space-md) 0 var(--space-2xl);
				padding: 0;
				display: grid;
				gap: var(--space-2xs);
			}
			.method li {
				padding-left: var(--space-sm);
				border-left: 2px solid var(--color-rule);
				color: var(--color-ink-2);
			}
			.latest h2 {
				border-top: none;
				margin-top: 0;
				padding-top: 0;
			}
			.report-list {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.report-list li {
				padding: var(--space-sm) 0;
				border-bottom: 1px solid var(--color-rule);
			}
			.report-list a {
				display: block;
				color: var(--color-ink);
				text-decoration: none;
			}
			.report-list a:hover .report-title {
				color: var(--color-accent);
			}
			.report-meta {
				font-family: var(--font-mono);
				font-size: var(--text-xs);
				color: var(--color-muted);
			}
			.report-title {
				font-family: var(--font-display);
				font-size: var(--text-lg);
				margin: var(--space-3xs) 0 0;
			}
			.report-desc {
				font-size: var(--text-sm);
				color: var(--color-muted);
				margin: var(--space-3xs) 0 0;
			}
			.all-link {
				display: inline-block;
				margin-top: var(--space-md);
				font-family: var(--font-mono);
				font-size: var(--text-sm);
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<h1>{SITE_TITLE}</h1>
				<p>{SITE_DESCRIPTION}</p>
				<p>
					這裡放滿了用 AI 分析的報告
				</p>
			</section>
			<section class="latest">
				<h2>最新報告</h2>
				{
					latest.length === 0 ? (
						<p>目前還沒有發布的報告。</p>
					) : (
						<ul class="report-list">
							{latest.map((post) => (
								<li>
									<a href={`/blog/${post.id}/`}>
										<span class="report-meta">
											<FormattedDate date={post.data.pubDate} />
										</span>
										<p class="report-title">{post.data.title}</p>
										<p class="report-desc">{post.data.description}</p>
									</a>
								</li>
							))}
						</ul>
					)
				}
				<a class="all-link" href="/blog">查看所有報告 &rarr;</a>
			</section>
		</main>
		<Footer />
	</body>
</html>
